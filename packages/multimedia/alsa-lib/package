description: Advanced Linux Sound Architecture - core libraries
version: 1.2.16.1
license: LGPL

depends:
  - devel/glibc

files:
  - download:
      url: https://www.alsa-project.org/files/pub/lib/alsa-lib-${version}.tar.bz2
      sha1: b28736b8a25fcdea9c4158fcfcfc480101dcc66c
      watch:
        url: anitya://38

packages:
  libalsa:
    files:
      - /usr/bin
      - /usr/lib/*.so.*
      - /usr/share/alsa

  libalsa-dev:
    files:
      - /usr/include
      - /usr/lib/*.so
      - /usr/lib/pkgconfig
      - /usr/share/aclocal

