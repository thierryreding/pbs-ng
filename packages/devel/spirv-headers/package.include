description: SPIR-V Headers
version: 1.4.350.0
license: custom

files:
  - download:
      url: https://github.com/KhronosGroup/SPIRV-Headers/archive/refs/tags/vulkan-sdk-${version}.tar.gz
      filename: spirv-headers-${version}.tar.gz
      sha1: 6df145a5bf9e3c6f965eee797c65dab38f717c86
      # We use the SPIRV-Tools Anitya ID here because SPIRV-Headers has some
      # bogus version numbers that mess up the ordering
      watch:
        url: anitya://334920 # SPIRV-Tools

