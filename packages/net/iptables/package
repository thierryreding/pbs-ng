description: Linux kernel packet control tool
version: 1.8.13
license: GPL-2.0

depends:
  - devel/glibc
  - net/libnftnl

files:
  - download:
      url: https://www.netfilter.org/pub/iptables/iptables-${version}.tar.xz
      sha1: e486c2df936fc080d2c0a2f5650c672e52e4ee8a
      watch:
        url: anitya://1394

packages:
  iptables:
    files:
      - /etc
      - /usr/bin
      - /usr/lib/*.so.*
      - /usr/lib/xtables
      - /usr/sbin

  iptables-dev:
    files:
      - /usr/include
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

  iptables-man:
    files:
      - /usr/share/man

