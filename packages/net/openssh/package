description: free version of the SSH connectivity tools
version: 10.5p1
license: custom

depends:
  - devel/glibc
  - libs/openssl

files:
  - download:
      url: https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${version}.tar.gz
      sha1: 3067e2af7c526b31c7e94bc3ed38904ef791eb2c
      watch:
        url: anitya://2565

packages:
  openssh:
    files:
      - /etc
      - /usr/bin
      - /usr/lib/ssh
      - /usr/lib/systemd

