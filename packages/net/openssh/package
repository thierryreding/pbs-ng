description: free version of the SSH connectivity tools
version: 10.3p1
license: custom

depends:
  - devel/glibc
  - libs/openssl

files:
  - download:
      url: https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${version}.tar.gz
      sha1: 9c78838ec07af14aff54f3755ac56ce6812452a9
      watch:
        url: anitya://2565

packages:
  openssh:
    files:
      - /etc
      - /usr/bin
      - /usr/lib/ssh
      - /usr/lib/systemd

