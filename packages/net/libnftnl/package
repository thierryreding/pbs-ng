      url: https://www.netfilter.org/pub/libnftnl/libnftnl-${version}.tar.xz
      sha1: 2f28c2c238a13a34bda814982f607f3bf6d75d81
      watch:
        url: anitya://1681

packages:
  libnftnl:
    files:
      - /usr/lib/*.so.*

  libnftnl-dev:
    files:
      - /usr/include
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

