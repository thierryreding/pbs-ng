include: packages/devel/llvm/package.include

description: library requirements of the OpenCL C programming language
license: MIT

depends:
  - build-tools/clang
  - build-tools/cmake
  - build-tools/spirv-tools
  - build-tools/spirv-llvm
  - devel/spirv-llvm

packages:
  libclc:
    files:
      - /usr/share/clc

  libclc-dev:
    files:
      - /usr/include
      - /usr/share/pkgconfig

