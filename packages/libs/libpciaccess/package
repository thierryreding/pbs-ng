description: X11 PCI access library
version: 0.19
license: custom

depends:
  - devel/glibc
  - libs/zlib

files:
  - download:
      url: https://xorg.freedesktop.org/releases/individual/lib/libpciaccess-${version}.tar.xz
      sha1: 4f83983d96d113ffebbc493715ee71a79ee24136
      watch:
        url: anitya://1703

packages:
  libpciaccess:
    files:
      - /usr/lib/*.so.*

  libpciaccess-dev:
    files:
      - /usr/include
      - /usr/lib/*.a
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

