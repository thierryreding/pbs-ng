description: library for manipulationg Unicode strings and C strings
version: 1.4.2
license: GPL

depends:
  - devel/glibc

files:
  - download:
      url: https://ftp.gnu.org/gnu/libunistring/libunistring-${version}.tar.gz
      sha1: 91be967d483213fb4990f64ee7b84236af99045a
      watch:
        url: anitya://1747

packages:
  libunistring:
    files:
      - /usr/lib/*.so.*

  libunistring-dev:
    files:
      - /usr/include
      - /usr/lib/*.a
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

