description: General purpose cryptographic library based on the code from GnuPG
version: 1.12.2
license: GPL

depends:
  - devel/glibc
  - libs/libgpg-error

files:
  - download:
      url: https://gnupg.org/ftp/gcrypt/libgcrypt/libgcrypt-${version}.tar.bz2
      sha1: 7b8ff21966a0b6e7a735466b9b9b55d9dac9fa87
      watch:
        url: anitya://1623

packages:
  libgcrypt:
    files:
      - /usr/lib/*.so.*

  libgcrypt-dev:
    files:
      - /usr/include
      - /usr/lib/*.a
      - /usr/lib/*.so
      - /usr/lib/pkgconfig
      - /usr/share/aclocal

