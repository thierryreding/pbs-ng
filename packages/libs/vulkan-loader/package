description: Vulkan loader
version: 1.4.355
license: Apache-2.0

depends:
  - build-tools/cmake
  - devel/glibc
  - libs/vulkan-headers
  - xorg/lib/x11
  - xorg/lib/xcb
  - xorg/lib/xrandr

files:
  - download:
      url: https://github.com/KhronosGroup/Vulkan-Loader/archive/refs/tags/v${version}.tar.gz
      sha1: 68d3f3c26df7b81cc5520ad48ac830fb190bf701
      watch:
        url: anitya://230557

packages:
  libvulkan:
    files:
      - /usr/lib/*.so.*

  libvulkan-dev:
    files:
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

