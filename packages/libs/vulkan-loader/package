description: Vulkan loader
version: 1.4.354
license: Apache-2.0

depends:
  - build-tools/cmake
  - devel/glibc
  - libs/vulkan-headers
  - xorg/lib/x11
  - xorg/lib/xcb
  - xorg/lib/xrandr

files:
  - download:
      url: https://github.com/KhronosGroup/Vulkan-Loader/archive/refs/tags/v${version}.tar.gz
      sha1: 09ba196e7385e65bf1525f5db8584f143c098b49
      watch:
        url: anitya://230557

packages:
  libvulkan:
    files:
      - /usr/lib/*.so.*

  libvulkan-dev:
    files:
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

