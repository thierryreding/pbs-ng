description: C library for the Public Suffix List
version: 0.22.0
license: MIT

depends:
  - devel/glibc
  - libs/libunistring

files:
  - download:
      url: https://github.com/rockdaboot/libpsl/releases/download/${version}/libpsl-${version}.tar.lz
      sha1: 83961e5fb679b1164d68bb14c84b257829183e4b
      watch:
        url: anitya://7305

packages:
  libpsl:
    files:
      - /usr/lib/*.so.*

  libpsl-dev:
    files:
      - /usr/include
      - /usr/lib/*.a
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

