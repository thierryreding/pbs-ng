description: TrueType font rendering library
version: 2.14.3
license: FreeType, GPL

depends:
  - libs/libpng

files:
  - download:
      url: https://download.savannah.gnu.org/releases/freetype/freetype-${version}.tar.xz
      sha1: 62e26b89a057ad4f1e28af977945d5c1975a8e67
      watch:
        url: anitya://854

packages:
  libfreetype:
    files:
      - /usr/lib/*.so.*

  libfreetype-dev:
    files:
      - /usr/include
      - /usr/lib/*.a
      - /usr/lib/*.so
      - /usr/lib/pkgconfig
      - /usr/share/aclocal

