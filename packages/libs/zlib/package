description: Compression library implementing the deflate compression method found in gzip and PKZIP
version: 1.3.2
license: Zlib

depends:
  - devel/glibc

files:
  - download:
      url: https://github.com/madler/zlib/releases/download/v${version}/zlib-${version}.tar.xz
      sha1: 6c9a55ad71ce9a7b252d4faf648ff66b56401e50
      watch:
        url: anitya://5303

packages:
  zlib:
    files:
      - /usr/lib/*.so.*

  zlib-dev:
    files:
      - /usr/include
      - /usr/lib/*.a
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

  zlib-man:
    files:
      - /usr/share/man

