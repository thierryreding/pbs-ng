description: Library to identify Wacom tablets and their features
version: 2.19.1
license: MIT

depends:
  - build-tools/meson
  - devel/python-libevdev
  - devel/python-pytest
  - devel/python-pyudev
  - libs/glib
  - libs/libevdev
  - libs/libgudev

files:
  - download:
      url: https://github.com/linuxwacom/libwacom/releases/download/libwacom-${version}/libwacom-${version}.tar.xz
      sha1: 7b827d3cf44aa1a2aec313c43ff5a142d412def3
      watch:
        url: anitya://16887

packages:
  libwacom:
    files:
      - /usr/lib/*.so.*

  libwacom-dev:
    files:
      - /usr/include
      - /usr/lib/*.a
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

