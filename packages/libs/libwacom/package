description: Library to identify Wacom tablets and their features
version: 2.19.0
license: MIT

depends:
  - build-tools/meson
  - devel/python-libevdev
  - devel/python-pytest
  - devel/python-pyudev
  - libs/glib
  - libs/libgudev

files:
  - download:
      url: https://github.com/linuxwacom/libwacom/releases/download/libwacom-${version}/libwacom-${version}.tar.xz
      sha1: 6a8f23cead1c9f8a74b3226c3b4f8bc289339062
      watch:
        url: anitya://16887

packages:
  libwacom:
    files:
      - /usr/lib/*.so.*

  libwacom-dev:
    files:
      - /usr/include
      - /usr/lib/*.a
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

