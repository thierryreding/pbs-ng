description: A JSON implementation in C
version: 0.19-20260627
license: LGPL-2.1 MPL-1.1

depends:
  - build-tools/cmake
  - devel/glibc

files:
  - download:
      url: https://github.com/json-c/json-c/archive/refs/tags/json-c-${version}.tar.gz
      sha1: 301f14d38892ef980fe83bbf59c1dfb8fe443074
      watch:
        url: anitya://1477

packages:
  libjson-c-dev:
    files:
      - /usr/include
      - /usr/lib/*.a
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

  libjson-c:
    files:
      - /usr/lib/*.so.*

