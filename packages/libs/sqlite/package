description: a C library that implements an SQL database engine
version: 3.53.4
license: custom

depends:
  - devel/glibc
  - libs/readline

files:
  - download:
      url: https://github.com/sqlite/sqlite/archive/refs/tags/version-${version}.tar.gz
      sha1: fd36cb0f105705b28dc939425bc089b58e4d6c68
      filename: sqlite-${version}.tar.gz
      watch:
        url: anitya://4877

packages:
  sqlite:
    files:
      - /usr/bin
      - /usr/lib/*.so.*

  sqlite-dev:
    files:
      - /usr/include
      - /usr/lib/*.a
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

