description: a C library that implements an SQL database engine
version: 3.53.3
license: custom

depends:
  - devel/glibc
  - libs/readline

files:
  - download:
      url: https://github.com/sqlite/sqlite/archive/refs/tags/version-${version}.tar.gz
      sha1: f3434f6648e58a952e29b5e78dbcdcbca7429761
      filename: sqlite-${version}.tar.gz
      watch:
        url: anitya://4877

packages:
  sqlite:
    files:
      - /usr/bin
      - /usr/lib/*.so.*

  sqlite-dev:
    files:
      - /usr/include
      - /usr/lib/*.a
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

