description: general purpose TCP-IP emulator
version: 4.9.3
license: MIT

depends:
  - build-tools/meson
  - libs/glib

files:
  - download:
      url: https://gitlab.freedesktop.org/slirp/libslirp/-/archive/v${version}/libslirp-v${version}.tar.bz2
      filename: libslirp-${version}.tar.bz2
      sha1: 0a71d4ca9253999a1e314d5de9c4d0e8ae3039a2
      watch:
        url: anitya://96796

packages:
  libslirp:
    files:
      - /usr/lib/*.so.*

  libslirp-dev:
    files:
      - /usr/include
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

