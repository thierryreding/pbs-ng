description: POSIX 1003.1e capabilities
version: 2.6.0
license: LGPL-2.1

depends:
  - devel/glibc

files:
  - download:
      url: https://download-mirror.savannah.gnu.org/releases/attr/attr-${version}.tar.gz
      sha1: c4f200d61beea5c26d6131288c0df3b5d11b4bfa
      watch:
        url: anitya://137

packages:
  libattr:
    files:
      - /usr/lib/*.so.*

  libattr-bin:
    files:
      - /usr/bin

  libattr-dev:
    files:
      - /usr/include
      - /usr/lib/*.so

  libattr-locale:
    files:
      - /usr/share/locale

  libattr-man:
    files:
      - /usr/share/man

