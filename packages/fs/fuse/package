description: FUSE (file system in userspace) library
version: 3.18.2
license: GPL-2.0

depends:
  - devel/glibc

files:
  - download:
      url: https://github.com/libfuse/libfuse/archive/fuse-${version}.tar.gz
      sha1: 2c269409be9ce6b2fdcd7a70eec80efdce2ddd68
      watch:
        url: anitya://861

packages:
  libfuse:
    files:
      - /usr/lib/*.so.*

  libfuse-dev:
    files:
      - /usr/include
      - /usr/lib/*.so
      - /usr/lib/pkgconfig

  fuse-utils:
    files:
      - /etc
      - /usr/bin

  fuse-man:
    files:
      - /usr/share/man

